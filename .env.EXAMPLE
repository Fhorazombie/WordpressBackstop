SITE_URL=https://example.com
SITEMAP_URL=/sitemap.xml
SITEMAP_SAMPLE_MODE=true
SAMPLE_SIZE=5
MAX_URLS=50
TIMEOUT=30000

# Tiempo de espera (ms) antes de capturar cada página. Subilo si el sitio
# tiene animaciones, lazy-load o contenido que tarda en renderizar.
# SCENARIO_DELAY=5000

# Configuración de Proyecto Backstop
PROJECT_ID=backstop_default
# Nombre de la subcarpeta para datos (dentro de backstop_data/)
# Dejar vacío para usar la raíz de backstop_data/
BACKSTOP_DATA_DIR=

# Headers opcionales (JSON)
# REQUEST_HEADERS={"Authorization": "Bearer token"}

# Debug
# DEBUG=true

# ─── Comparación Diseño vs. Live URL ────────────────────────────────────────
# Ruta a la imagen PNG/JPG exportada de Figma o enviada por el diseñador
# DESIGN_IMAGE=./designs/homepage.png

# URL del sitio a comparar (si no se define, se usa SITE_URL)
# DESIGN_URL=https://misite.com

# Nombre del escenario en el reporte (opcional — por defecto usa el nombre del archivo)
# DESIGN_LABEL=Homepage

# Tolerancia de diferencia en porcentaje (default: 0.1)
# DESIGN_THRESHOLD=0.1

# Selectores CSS a ocultar antes de capturar (separados por coma, opcional)
# DESIGN_HIDE=.cookie-banner,.chat-widget

# Alto del viewport en píxeles (default: 900 — el ANCHO siempre viene de la imagen)
# DESIGN_VIEWPORT_HEIGHT=900
