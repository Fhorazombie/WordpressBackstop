SITE_URL=https://example.com
SITEMAP_URL=/sitemap.xml
SITEMAP_SAMPLE_MODE=true
SAMPLE_SIZE=5
MAX_URLS=50
TIMEOUT=30000

# Tiempo de espera (ms) antes de capturar cada página. Subilo si el sitio
# tiene animaciones, lazy-load o contenido que tarda en renderizar.
# SCENARIO_DELAY=5000

# Selectores CSS a aplicar en TODOS los escenarios generados (separados por
# coma). SCENARIO_HIDE oculta el elemento pero reserva su espacio
# (visibility:hidden — queda un hueco en blanco). SCENARIO_REMOVE lo saca
# del flujo del documento (display:none — el contenido de abajo sube).
# Para un elemento sin clase/id, alcanza con su etiqueta (ej: "header").
# SCENARIO_HIDE=.cookie-banner,.chat-widget
# SCENARIO_REMOVE=header,.announcement-bar

# Configuración de Proyecto Backstop
PROJECT_ID=backstop_default
# Nombre de la subcarpeta para datos (dentro de backstop_data/)
# Dejar vacío para usar la raíz de backstop_data/
BACKSTOP_DATA_DIR=

# Headers opcionales (JSON)
# REQUEST_HEADERS={"Authorization": "Bearer token"}

# Debug
# DEBUG=true

# Cuántas corridas (referencia/prueba/generación) puede ejecutar el panel al
# mismo tiempo. Cada una lanza su propio Chromium — solo aplica al panel web
# (npm run ui), no al CLI. Default: 3.
# MAX_CONCURRENT_RUNS=3

# ─── Panel web: login (Postgres) ────────────────────────────────────────────
# Cadena de conexión a Postgres, usada tanto para los usuarios como para las
# sesiones de login del panel (npm run ui). Requerida para iniciar el panel.
# DATABASE_URL=postgres://usuario:password@localhost:5432/backstop_ui

# Clave usada para firmar la cookie de sesión. Cambiala por un valor propio,
# largo y aleatorio, antes de usar el panel en producción.
# SESSION_SECRET=cambiame-por-un-valor-largo-y-aleatorio

# ─── Comparación Diseño vs. Live URL ────────────────────────────────────────
# Ruta a la imagen PNG/JPG exportada de Figma o enviada por el diseñador
# DESIGN_IMAGE=./designs/homepage.png

# URL del sitio a comparar (si no se define, se usa SITE_URL)
# DESIGN_URL=https://misite.com

# Nombre del escenario en el reporte (opcional — por defecto usa el nombre del archivo)
# DESIGN_LABEL=Homepage

# Tolerancia de diferencia en porcentaje (default: 0.1)
# DESIGN_THRESHOLD=0.1

# Selectores CSS a ocultar antes de capturar (separados por coma, opcional).
# visibility:hidden — reserva el espacio del elemento (queda un hueco en blanco)
# DESIGN_HIDE=.cookie-banner,.chat-widget

# Selectores CSS a quitar antes de capturar (separados por coma, opcional).
# display:none — el contenido de abajo sube a ocupar ese espacio.
# Para un elemento sin clase/id, alcanza con su etiqueta (ej: "header").
# DESIGN_REMOVE=header,.cookie-banner

# Alto del viewport en píxeles (default: 900 — el ANCHO siempre viene de la imagen)
# DESIGN_VIEWPORT_HEIGHT=900
